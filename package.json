{
  "name": "noelia-duque-makeup",
  "version": "1.0.0",
  "private": true,
  "description": "Web y sistema de gestión de citas para Noelia Duque Make up Artist",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --watch --disable-warning=ExperimentalWarning server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "demo": "node --disable-warning=ExperimentalWarning scripts/seed-demo.js",
    "preview:panel": "node scripts/build-preview.mjs panel-preview.html public/img/work"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
