# Copia este archivo a /etc/noelia.env en el servidor (lo hace deploy/install.sh) y rellénalo.
PORT=3000
DATA_DIR=/var/lib/noelia
SITE_URL=https://www.tudominio.es
TRUST_PROXY=1
# Contraseña inicial del panel (solo se usa la primera vez; después cámbiala en Ajustes)
ADMIN_PASSWORD=pon-aqui-una-contraseña-larga
# Correo saliente (opcional pero recomendado)
#SMTP_HOST=smtp.ionos.es
#SMTP_PORT=587
#SMTP_USER=noeliaduquebrowandmakeup@gmail.com
#SMTP_PASS=
#SMTP_FROM="Noelia Duque <noeliaduquebrowandmakeup@gmail.com>"
# Lectura automática de facturas con IA (opcional): npm install @anthropic-ai/sdk
#ANTHROPIC_API_KEY=
