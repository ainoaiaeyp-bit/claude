# Copia este archivo a .env y rellénalo.

PORT=3000
# URL pública donde corre la app (se usa en los enlaces de baja y confirmación).
BASE_URL=http://localhost:3000

# Acceso al panel (HTTP Basic). Obligatorio, mínimo 8 caracteres.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Resend. Sin clave, la app funciona en modo simulación (no envía nada, solo registra).
RESEND_API_KEY=
# Secreto del webhook (empieza por whsec_). Panel de Resend → Webhooks.
RESEND_WEBHOOK_SECRET=

# Remitente por defecto (el dominio debe estar verificado en Resend).
FROM_NAME=Mi Empresa
FROM_EMAIL=hola@tudominio.com
REPLY_TO=

# Dirección postal que aparece en el pie de cada email (exigida por la LSSI / CAN-SPAM).
COMPANY_ADDRESS=Mi Empresa S.L. · Calle Ejemplo 1, 28001 Madrid

# true = los nuevos suscriptores deben confirmar por email (recomendado en la UE).
DOUBLE_OPT_IN=true

DB_PATH=./data/mailer.db
# Pausa entre lotes de 100 emails. Resend permite 2 peticiones/s por defecto.
SEND_INTERVAL_MS=600
# true si hay un proxy inverso delante (usa X-Forwarded-For para limitar abusos en el alta pública).
TRUST_PROXY=false
