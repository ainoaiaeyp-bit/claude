# Copia este archivo a ".env" y rellénalo. NO lo subas a git.

# Dominio público del editor (debe apuntar a la IP de tu VPS). Con "localhost" usa HTTPS local.
DOMAIN=lienzo.midominio.com

# --- Proxy de IA (solo si arrancas el perfil "ai") ---
ANTHROPIC_API_KEY=
# Para verificar que quien llama tiene sesión (mismos valores que en config.js):
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=
# Límite de peticiones de IA por usuario y hora, y tope de tokens de salida:
AI_RATE_PER_HOUR=30
AI_MAX_TOKENS=4500
